{
  "name": "gsd-config-manager",
  "version": "0.1.0",
  "type": "module",
  "description": "Zero-config-friendly desktop-grade tool for viewing, understanding, and safely editing GSD (open-gsd/gsd-core) configuration files.",
  "bin": {
    "gsd-config-manager": "./dist/cli.js",
    "gsd-config-editor": "./dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/client/**"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "test": "npm run test:ordinary && npm run test:integration",
    "test:ordinary": "vitest run --exclude test/server/cli-launch.test.ts --exclude test/server/teardown.test.ts --exclude test/packaging/tarball-contents.test.ts --exclude test/helpers/process-tree.test.ts",
    "test:integration": "vitest run test/helpers/process-tree.test.ts test/server/cli-launch.test.ts test/server/teardown.test.ts test/packaging/tarball-contents.test.ts --pool=forks --maxWorkers=1 --no-file-parallelism",
    "test:unit": "vitest run test/config-io --reporter=dot",
    "test:server": "vitest run test/server --reporter=dot",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit",
    "build:schema": "tsx packages/schema-data/scripts/build-schema.ts",
    "build:cli": "tsup",
    "build:client": "vite build",
    "build": "npm run build:cli && npm run build:client",
    "prepublishOnly": "npm run build",
    "cli:start": "node dist/cli.js"
  },
  "dependencies": {
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lint": "6.9.7",
    "@fastify/cors": "11.3.0",
    "@fastify/static": "10.1.0",
    "@hookform/resolvers": "5.4.0",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "5.101.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "codemirror": "6.0.2",
    "commander": "15.0.0",
    "env-paths": "4.0.0",
    "fastify": "5.10.0",
    "json-diff-kit": "1.0.35",
    "lucide-react": "^1.24.0",
    "open": "11.0.0",
    "playwright": "^1.61.1",
    "proper-lockfile": "4.1.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.81.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "typescript": "5.9.3",
    "write-file-atomic": "7.0.1",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.1",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "jsdom": "29.1.1",
    "tsup": "8.5.1",
    "tsx": "4.23.0",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  },
  "license": "MIT",
  "author": "FiredMosquito831",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FiredMosquito831/open-gsd-core-config-manager.git"
  },
  "homepage": "https://github.com/FiredMosquito831/open-gsd-core-config-manager#readme",
  "bugs": {
    "url": "https://github.com/FiredMosquito831/open-gsd-core-config-manager/issues"
  },
  "keywords": [
    "gsd",
    "open-gsd",
    "gsd-core",
    "config",
    "config-editor",
    "configuration-manager",
    "claude",
    "developer-tools",
    "local-first",
    "json-schema"
  ]
}
