{
  "name": "gsd-config-manager",
  "version": "0.1.0",
  "type": "module",
  "description": "Zero-config-friendly desktop-grade tool for viewing, understanding, and safely editing GSD (open-gsd/gsd-core) configuration files.",
  "bin": {
    "gsd-config-manager": "./dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/client/**"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run test/config-io --reporter=dot",
    "test:server": "vitest run test/server --reporter=dot",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit",
    "build:schema": "tsx packages/schema-data/scripts/build-schema.ts",
    "build:cli": "tsup",
    "build:client": "vite build",
    "build": "npm run build:cli && npm run build:client",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/static": "10.1.0",
    "@hookform/resolvers": "5.4.0",
    "@tanstack/react-query": "5.101.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "commander": "15.0.0",
    "env-paths": "4.0.0",
    "fastify": "5.10.0",
    "open": "11.0.0",
    "proper-lockfile": "4.1.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.81.0",
    "write-file-atomic": "7.0.1",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.1",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "jsdom": "29.1.1",
    "tsup": "8.5.1",
    "tsx": "4.23.0",
    "typescript": "5.9.3",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
