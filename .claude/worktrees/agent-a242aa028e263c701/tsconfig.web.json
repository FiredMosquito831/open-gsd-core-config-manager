{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "skipLibCheck": true, "noEmit": true, "jsx": "react-jsx",
    "resolveJsonModule": true, "types": ["vitest/globals"]
  },
  "include": ["web/src/**/*.ts", "web/src/**/*.tsx", "test/web/**/*.ts", "test/web/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
